{
  "manifest_version": 3,
  "name": "h3aven",
  "version": "1.1.0",
  "description": "Save the page you're on to your h3aven library in one click.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to h3aven",
    "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png" }
  },
  "options_page": "options.html",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://*.supabase.co/*"],
  "content_scripts": [
    {
      "matches": ["https://h3aven.netlify.app/*", "http://localhost:5500/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
